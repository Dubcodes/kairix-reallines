; RP2040 quadrature x4 state table. Based on the Raspberry Pi pico-examples
; quadrature_encoder PIO example (Raspberry Pi (Trading) Ltd., BSD-3-Clause).
; Licensed under BSD-3-Clause; see https://github.com/raspberrypi/pico-examples
.program quadrature_encoder
.origin 0
    jmp update
    jmp decrement
    jmp increment
    jmp update
    jmp increment
    jmp update
    jmp update
    jmp decrement
    jmp decrement
    jmp update
    jmp update
    jmp increment
    jmp update
    jmp increment
decrement:
    jmp y--, update
.wrap_target
update:
    mov isr, y
    push noblock
    out isr, 2
    in pins, 2
    mov osr, isr
    mov pc, isr
increment:
    mov y, ~y
    jmp y-- inc_done
inc_done:
    mov y, ~y
.wrap
