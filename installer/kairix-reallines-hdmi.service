[Unit]
Description=Kairix RealLines dedicated HDMI graphics output
After=network-online.target kairix-reallines-dev.service
Wants=network-online.target

[Service]
Type=simple
User=reallines
Group=reallines
SupplementaryGroups=video render input
RuntimeDirectory=kairix-hdmi
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kairix-hdmi
Environment=KAIRIX_HDMI_CONFIG=/home/reallines/kairix-reallines/data/hdmi_output.json
Environment=KAIRIX_GFX_URL=http://127.0.0.1:8080/gfx?metrics_name=HDMI
ExecStart=/usr/local/lib/kairix-reallines/kairix-hdmi-launcher
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
